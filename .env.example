# ==============================================================================
# Guia de Praias & Serviços Ubatuba — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha. TUDO É OPCIONAL:
# sem estas variáveis o app roda 100% com o MockDataService local (localStorage),
# conforme descrito em docs/ARCHITECTURE.md seção 4.
# ==============================================================================

# --- Supabase (opcional) -----------------------------------------------------
# Com estas duas variáveis preenchidas o app sincroniza com o banco em nuvem.
# Sem elas, o app usa o fallback local automaticamente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin (opcional) --------------------------------------------------------
# Senha do painel /admin. Se não for definida, o app usa a senha padrão de
# desenvolvimento documentada em src/services/auth.ts (apenas para dev local).
VITE_ADMIN_PASSWORD=

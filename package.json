{
  "name": "guia-de-praias-ubatuba",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Guia de Praias & Serviços Ubatuba - PWA mobile-first e offline-first",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
